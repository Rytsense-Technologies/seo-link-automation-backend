# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
# Optional: when set, every /api request must send the header `X-API-Key: <value>`.
API_KEY=
# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]

# PostgreSQL (SQLAlchemy URL, psycopg 3 driver). Manage/inspect the DB with pgAdmin.
DATABASE_URL=postgresql+psycopg://postgres:*****@localhost:5432/link_automation
# Used by `pytest -m postgres` and `npm run test:integration`; must be a separate,
# disposable database (it is migrated up and down; Node requires "test" in its name).
TEST_DATABASE_URL=

# AI provider: gemini | groq | openai | none
AI_PROVIDER=gemini
AI_API_KEY=
# Optional overrides (defaults: gemini-2.5-flash / llama-3.3-70b-versatile / gpt-4o-mini)
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0.2

# Optional secondary provider, tried once if the primary one fails (e.g. Gemini "503 high demand").
# Leave AI_FALLBACK_PROVIDER=none to disable. Timeout/temperature are shared with the primary.
AI_FALLBACK_PROVIDER=none
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=

# Interlink module
INTERLINK_MIN_RELEVANCE_SCORE=70
INTERLINK_CANDIDATE_POOL_SIZE=15
INTERLINK_MAX_SUGGESTIONS_PER_PAGE=5
INTERLINK_REJECTION_COOLDOWN_DAYS=30
INTERLINK_MAX_ANCHOR_REUSE=3
INTERLINK_SOURCE_CONTENT_MAX_CHARS=6000
INTERLINK_TARGET_EXCERPT_CHARS=300
INTERLINK_REQUIRE_REGION_MATCH=true
# Minimum 0-1 score for deterministic suggestions (analyze with use_ai=false, or ai_fallback=true).
INTERLINK_DETERMINISTIC_MIN_SCORE=0.35
# JSON lists; override to customise utility-page detection.
# INTERLINK_UTILITY_PAGE_TYPES=["utility","system","legal","auth","search","archive"]
# INTERLINK_UTILITY_PATH_PATTERNS=["^/(login|cart|privacy-policy)(/|$)"]

# Crawler (POST /api/sites/{site_id}/crawl)
CRAWLER_USER_AGENT=SEOLinkAutomationBot/0.1
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_RETRIES=2
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_RESPONSE_BYTES=5000000
CRAWLER_REQUEST_DELAY_SECONDS=0.5
CRAWLER_MAX_CRAWL_DELAY_SECONDS=10
CRAWLER_MAX_PAGES_LIMIT=1000
CRAWLER_MAX_SITEMAPS=50
